# Copy this file to .env.aws (it is git-ignored) and fill in ONE of the credential options.

AWS_REGION=us-east-2
BEDROCK_MODEL_ID=us.amazon.nova-micro-v1:0
BEDROCK_VISION_MODEL_ID=us.amazon.nova-lite-v1:0

# Option 1: Amazon Bedrock API key (Bedrock console > API keys)
AWS_BEARER_TOKEN_BEDROCK=

# Option 2: IAM access key with permission to invoke Bedrock models
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
